{
  "name": "secundo",
  "version": "0.1.0",
  "description": "Single-file executable packer for script-based applications",
  "type": "module",
  "main": "dist/secundo.js",
  "bin": {
    "secundo": "dist/secundo.js"
  },
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude src/integration.test.ts",
    "test:watch": "vitest --exclude src/integration.test.ts",
    "test:integration": "vitest run src/integration.test.ts",
    "test:all": "vitest run"
  },
  "keywords": [
    "packer",
    "bundler",
    "cli",
    "portable",
    "self-extracting"
  ],
  "author": "Stefan",
  "license": "MIT",
  "dependencies": {
    "@noble/ed25519": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "esbuild": "^0.19.8",
    "typescript": "^5.3.2",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
